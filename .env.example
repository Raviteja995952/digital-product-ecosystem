# Frontend (Vite)
# Live backend API base URL (leave empty in local dev to use Vite proxy)
VITE_API_BASE_URL=

# Backend (Spring Boot - Optional overrides for production MySQL)
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ecosystem_db?createDatabaseIfNotExist=true
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=your_password

