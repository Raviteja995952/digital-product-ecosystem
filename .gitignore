# ==============================================================================
# DIGITAL PRODUCT ECOSYSTEM - GIT IGNORE
# Comprehensive ignore rules for React (Vite) Frontend & Spring Boot Backend
# ==============================================================================

# Node / JavaScript Dependencies & Package Managers
node_modules/
frontend/node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Frontend Build Artifacts
dist/
frontend/dist/
build/
.vite/
frontend/.vite/

# Environment Files & Secrets (Never commit actual env credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
frontend/.env
frontend/.env.local
frontend/.env.*.local
*.env
*.env.*
!*.env.example
!frontend/.env.example

# Cryptographic Keys & Secrets
*.pem
*.key
*.keystore
secrets.*
credentials.json
id_rsa*

# Java / Maven Build Outputs
target/
backend/target/
*/target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar

# Database & Log Files
*.db
*.sqlite
*.sqlite3
backend/*.db
*.log
logs/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Tt]humbs.db

# IDE & Editor Configurations
.idea/
*.iml
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
.springBeans

# Temporary files
*.tmp
*.bak
*.swp
*~

