# ==============================================================================
# FRONTEND ENVIRONMENT CONFIGURATION (Vite)
# ==============================================================================
# Base URL for the Java Spring Boot REST API.
# - In local development: Leave empty (uses Vite proxy /api -> http://localhost:8080)
#   or set to http://localhost:8080
# - In production (e.g. Vercel deployment):
#   Set to your live backend domain (e.g., https://api.yourdomain.com or https://ecosystem-backend.railway.app)
VITE_API_BASE_URL=

